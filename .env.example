# ===========================================
# Docker Compose Environment Variables
# Copy this file to .env and update values
# Docker Compose reads .env automatically
# ===========================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=superuser
POSTGRES_DB=sprout_assessment_db

# API Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=sprout_digital_lab_assessment_key
JWT_REFRESH_SECRET=sprout_digital_lab_assessment_refresh_key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CORS_ORIGIN=http://sda-dev.local
LOG_LEVEL=debug
API_PREFIX=/api/v1

# Nginx/Docker
SERVER_NAME=sda-dev.local
DOCKERHUB_USERNAME=handraromeldocker
